{
  "name": "dsh-permission-modes",
  "version": "1.0.1",
  "type": "module",
  "description": "Two independent composer controls over the DSH permission presets: file permission (sandbox) and approval policy, each switching one dimension with six presets behind them.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-permission-presets"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/peter9130/dsh-permission-modes.git"
  },
  "homepage": "https://github.com/peter9130/dsh-permission-modes#readme",
  "bugs": {
    "url": "https://github.com/peter9130/dsh-permission-modes/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "permission",
    "sandbox",
    "approval",
    "web-ui"
  ],
  "publishConfig": {
    "access": "public"
  }
}
